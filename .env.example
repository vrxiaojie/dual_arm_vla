# Copy this file to .env and fill in your provider's values.
# OpenAI-compatible API root, for example https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=replace-with-your-model-name
# Optional: minimal, low, medium, high, or xhigh. Leave blank if unsupported.
LLM_REASONING_EFFORT=
